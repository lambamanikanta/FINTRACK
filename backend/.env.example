PORT=5000

# Option A — Global Atlas (paste hostname only; user/password/db separate)
# Atlas → Connect → Drivers shows: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/...
# Copy only: cluster0.xxxxx.mongodb.net
ATLAS_CLUSTER_HOST=cluster0.xxxxx.mongodb.net
ATLAS_DB_USER=fintrack
ATLAS_DB_PASSWORD=your-db-user-password
ATLAS_DB_NAME=fintrack

# Option B — Full URI (overrides Option A if set)
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/fintrack?retryWrites=true&w=majority
MONGODB_URI=

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Vite dev: http://localhost:5173  |  Docker web on 80: http://localhost
# Multiple origins can be comma-separated (no trailing slash).
CORS_ORIGIN=http://localhost:5173
