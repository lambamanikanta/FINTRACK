# Copy to .env next to docker-compose.yml (used by docker compose for api + web build)

# --- MongoDB Atlas (pick A or B) ---
# A) Full URI from Atlas → Connect → Drivers
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fintrack?retryWrites=true&w=majority
MONGODB_URI=

# B) Hostname + DB user (backend builds mongodb+srv://…)
ATLAS_CLUSTER_HOST=
ATLAS_DB_USER=fintrack
ATLAS_DB_PASSWORD=
ATLAS_DB_NAME=fintrack

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Browser origin for the SPA (Docker web is usually http://localhost on port 80)
CORS_ORIGIN=http://localhost

# Frontend build: leave empty when nginx proxies /api to the api container. Set only if API is on another origin.
VITE_API_URL=
